# GitHub language statistics.
# Generated art, fonts and screenshots are build output / assets, not source.
client/assets/** linguist-vendored
docs/images/** linguist-documentation
*.svg linguist-vendored
*.woff2 linguist-vendored
*.png linguist-vendored
*.webp linguist-vendored

# Keep the hand-written game source counted.
client/js/** linguist-language=JavaScript
shared/** linguist-language=JavaScript
server/** linguist-language=JavaScript
scripts/** linguist-language=JavaScript
tests/** linguist-language=JavaScript

# Normalise line endings on checkout.
* text=auto
*.svg text
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
