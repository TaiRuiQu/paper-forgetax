# Shared listening address (use 0.0.0.0 for LAN access)
HOST=127.0.0.1

# API and frontend ports
PORT=3001
WEB_PORT=5173

# Optional storage and signing settings (defaults apply when omitted)
# FORGETAX_DATA_DIR=./server/data
# FORGETAX_DB=./server/data/forgetax.db
# FORGETAX_SECRET_FILE=./server/data/secret.key
# FORGETAX_SECRET=

# Experimental: answer with protobuf when the client asks for it.
# Requests may always be protobuf. Set to 0 to answer JSON only.
# FORGETAX_PROTOBUF=1
